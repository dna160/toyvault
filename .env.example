# toyvault-api (set as Railway variables in production; never commit real values)
DATABASE_URL=postgres://toyvault:toyvault@localhost:5432/toyvault
CONNECTOR_TOKEN=change-me-long-random-string
PORT=3000
# S3-compatible bucket (Railway bucket references in production)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
